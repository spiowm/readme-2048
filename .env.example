# Where a move redirects
PROFILE_URL=https://github.com/spiowm
# Secret for hashing player IPs; if empty, one is generated and kept in the database
PLAYER_SALT=
# Token for GET /stats, an empty value turns the endpoint off
STATS_TOKEN=
# Minimum pause between moves of one player, in seconds
MIN_MOVE_INTERVAL=0.3
# SQLite file with the game state and stats
DB_PATH=/data/game.db
